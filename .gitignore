# temp files
.temp/
*.tmp
*.temp

# local binaries (downloaded, not source)
obscura
obscura-worker
obscura-*.tar.gz

# deps / build output
node_modules/
out/
dist/

# rendered media (temp renders only — the asset library IS committed)
*.mp4
*.mov

# keep the shared asset library tracked
# NOTE: assets/clips is NOT committed — footage is re-downloaded from pinned
# Pexels ids in episodes/<slug>/clips.json (see the `stock` step). Keeps the repo
# small and the render reproducible. credits.json stays for attribution.
!assets/music/**
!assets/sfx/**
!assets/clips/**/credits.json
!assets/art/**
!assets/backgrounds/**
!assets/fonts/**
!assets/svg/**

.env
